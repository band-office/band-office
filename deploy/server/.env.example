# TECHNICAL PREVIEW: no supported Band Office Server image is currently published.
# Use only a controlled preview image supplied or built by district IT with fictional data.
# A future supported release must provide an exact tag and immutable digest.
BAND_OFFICE_IMAGE=ghcr.io/REPLACE_WITH_CONTROLLED_PREVIEW_OWNER/band-office:PREVIEW_VERSION

# Public DNS hostname. Do not include https:// or a path.
BAND_OFFICE_HOSTNAME=band.example.org

# Caddy uses this address for certificate-expiration notices.
ACME_EMAIL=it@example.org

# IANA timezone used for school-local dates and scheduled communications.
BAND_OFFICE_TIMEZONE=America/New_York
